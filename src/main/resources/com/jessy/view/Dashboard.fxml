<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>

<!--
  Dashboard.fxml
  Vue d'ensemble : statistiques, prochains événements, mini agenda.
  Controller: com.jessy.controllers.DashboardController
  Plein écran, thème café glass.
-->
<StackPane xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.jessy.controller.DashboardController"
        styleClass="app-background" prefWidth="1440" prefHeight="900">

    <BorderPane>

        <!-- ===== Sidebar ===== -->
        <left>
            <fx:include source="Sidebar.fxml"/>
        </left>

        <!-- ===== Contenu principal ===== -->
        <center>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                <VBox spacing="26" styleClass="content-area">
                    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

                    <!-- En-tête -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="4">
                            <Label text="Bonjour, Jessy ☕" styleClass="title-xl"/>
                            <Label fx:id="lblDateAujourdhui" text="Vendredi 18 septembre 2026" styleClass="subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRechercher" text="🔍" styleClass="btn-icon"/>
                        <Button fx:id="btnNotifTop" text="🔔" styleClass="btn-icon"/>
                        <Button text="+ Nouvel événement" styleClass="btn-primary" onAction="#nouvelEvenement"/>
                    </HBox>

                    <!-- Cartes de statistiques -->
                    <HBox spacing="20">
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="Événements aujourd'hui" styleClass="muted-text"/>
                            <Label fx:id="lblStatAujourdhui" text="4" styleClass="stat-number"/>
                            <Label text="2 cours · 2 réunions" styleClass="muted-text"/>
                        </VBox>
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="Cette semaine" styleClass="muted-text"/>
                            <Label fx:id="lblStatSemaine" text="17" styleClass="stat-number"/>
                            <Label text="+3 vs semaine dernière" styleClass="muted-text"/>
                        </VBox>
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="Récurrents actifs" styleClass="muted-text"/>
                            <Label fx:id="lblStatRecurrents" text="6" styleClass="stat-number"/>
                            <Label text="Cours hebdomadaires" styleClass="muted-text"/>
                        </VBox>
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="Notifications" styleClass="muted-text"/>
                            <Label fx:id="lblStatNotifs" text="3" styleClass="stat-number"/>
                            <Label text="Non lues" styleClass="muted-text"/>
                        </VBox>
                    </HBox>

                    <!-- Corps : agenda du jour + prochains événements -->
                    <HBox spacing="20">

                        <!-- Timeline du jour -->
                        <VBox styleClass="glass-pane" spacing="14" HBox.hgrow="ALWAYS" prefWidth="640">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Emploi du temps du jour" styleClass="title-md"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Voir tout" styleClass="btn-secondary" onAction="#allerEvenements"/>
                            </HBox>
                            <Separator styleClass="divider"/>

                            <ListView fx:id="listeAgendaJour" styleClass="glass-pane" prefHeight="380"
                                      style="-fx-background-color: transparent;">
                                <!-- Remplie dynamiquement par le contrôleur avec des cellules
                                     personnalisées (heure, titre, lieu, badge de couleur) -->
                            </ListView>
                        </VBox>

                        <!-- Mini calendrier + prochains événements -->
                        <VBox spacing="20" prefWidth="360">

                            <VBox styleClass="glass-pane" spacing="12">
                                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Button text="‹" styleClass="btn-icon" onAction="#moisPrecedent"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblMoisAffiche" text="Septembre 2026" styleClass="title-md"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="›" styleClass="btn-icon" onAction="#moisSuivant"/>
                                </HBox>
                                <GridPane fx:id="grilleMiniCalendrier" hgap="6" vgap="6">
                                    <!-- Peuplée dynamiquement par le contrôleur -->
                                </GridPane>
                            </VBox>

                            <VBox styleClass="glass-pane" spacing="12" VBox.vgrow="ALWAYS">
                                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                                <Label text="Prochains événements" styleClass="title-md"/>
                                <Separator styleClass="divider"/>
                                <VBox fx:id="listeProchainsEvenements" spacing="10">
                                    <!-- Cartes d'événements peuplées dynamiquement -->
                                </VBox>
                            </VBox>

                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>

    <!-- Bouton flottant d'ajout rapide -->
    <Button text="+" styleClass="btn-fab" StackPane.alignment="BOTTOM_RIGHT"
            translateX="-40" translateY="-40" onAction="#nouvelEvenement"/>

</StackPane>
