<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" styleClass="root-background"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jessy.controller.RegisterController"
            prefWidth="900" prefHeight="600">

    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Conteneur de la carte verre : StackPane pour pouvoir superposer le reflet -->
        <StackPane maxWidth="400" maxHeight="620" alignment="TOP_CENTER">

            <VBox fx:id="cardRegister" styleClass="card" alignment="CENTER" spacing="14"
                maxWidth="400" maxHeight="620">

                <padding>
                    <Insets top="36" right="40" bottom="36" left="40"/>
                </padding>

                <Label text="☕" styleClass="icon-logo"/>

                <Label text="Créer un compte" styleClass="title-text"/>
                <Label text="Rejoignez-nous en quelques secondes" styleClass="subtitle-text"/>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Nom" styleClass="field-label"/>
                    <TextField fx:id="champNom" promptText="Rakoto" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Prénom" styleClass="field-label"/>
                    <TextField fx:id="champPrenom" promptText="Jessy" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="champEmail" promptText="vous@exemple.com" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="champPassword" promptText="••••••••" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Confirmer le mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="champConfirmation" promptText="••••••••" styleClass="input-field"/>
                </VBox>

                <Label fx:id="labelErreur" styleClass="error-text" visible="false" managed="false"/>

                <Button fx:id="btnInscription" text="S'inscrire" styleClass="btn-primary"
                        maxWidth="Infinity" onAction="#onClickInscription"/>

                <HBox alignment="CENTER" spacing="4">
                    <Label text="Déjà un compte ?" styleClass="footer-text"/>
                    <Hyperlink text="Se connecter" styleClass="link-text" onAction="#onClickAllerLogin"/>
                </HBox>

            </VBox>

            <!-- Reflet du verre : bande lumineuse en haut, ne bloque pas les clics -->
            <Region styleClass="card-glow" maxHeight="90" mouseTransparent="true"
                    StackPane.alignment="TOP_CENTER"/>

        </StackPane>
    </StackPane>
</AnchorPane>
